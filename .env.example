# ──────────────────────────────────────────────────────────────────────────────
# Supabase — get values from: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side only — never expose to browser
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ──────────────────────────────────────────────────────────────────────────────
# Cron webhook security
# Generate: openssl rand -hex 32
# Add as Authorization: Bearer <secret> header in your pg_cron calls
# ──────────────────────────────────────────────────────────────────────────────
CRON_SECRET=your-secret-here

# ──────────────────────────────────────────────────────────────────────────────
# Mapbox — rider live-tracking map
# Get a free public token at: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 map loads / month
# ──────────────────────────────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoixxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (optional)
# Leave blank to run in noop mode — notifications queued but not sent
# Get from: Meta Developer Console → WhatsApp Business → API Setup
# ──────────────────────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=EAAxx...
WHATSAPP_PHONE_ID=1234567890
